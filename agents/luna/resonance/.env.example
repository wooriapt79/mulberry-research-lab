# Resonance AI Finetuning 환경 변수
# cp .env.example .env  후 값 입�%

# ── HuggingFace 토큰 ────────────────────────────────────────────
# Mistral-7B 사용 시 불필요 (완전 공개 모델)
# Llama-2 사용 시 필수 (Meta 승인 + HF 토큰 필요)
HF_TOKEN=your_hf_token_here

# ── 모델 선택 ────────────────────────────────────────────────────
# 기본값: mistralai/Mistral-7B-v0.1  (HF_TOKEN 불필요)
# Llama-2: meta-llama/Llama-2-7b-hf (HF_TOKEN 필수)
MODEL_NAME=mistralai/Mistral-7B-v0.1

# ── 경로 설정 ─────────────────────────────────────────────────────
DATASET_PATH=resonance_finetuning_dataset_v2.jsonl
OUTPUT_DIR=./lora-resonance-v2
